DATABASE_URL=postgres://postgres:changeme@localhost:5432/warehouse
JWT_ACCESS_SECRET=xxx
JWT_REFRESH_SECRET=yyy
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Server bind host. Default `::` (IPv6 dual-stack) — required for Railway private networking.
HOST=::
# Port the server listens on (Railway injects its own PORT, which overrides this).
PORT=3003
# Comma-separated CORS allowlist (browser origins). Set to the FE's public URL in prod.
CORS_ORIGIN=http://localhost:3000

S3_ENDPOINT=https://<your-bucket-endpoint>
S3_REGION=auto
S3_BUCKET=warehouse-bills
S3_ACCESS_KEY_ID=xxx
S3_SECRET_ACCESS_KEY=yyy
S3_FORCE_PATH_STYLE=true
S3_PREFIX=
# Optional: host used to sign presigned URLs (set only if S3_ENDPOINT is private/internal).
S3_PUBLIC_ENDPOINT=
